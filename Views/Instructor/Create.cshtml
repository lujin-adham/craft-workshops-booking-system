@model CraftWorkshopSystem.Models.Instructor

@{
    ViewData["Title"] = "Add Instructor";
}

<div class="container mt-4 mb-5">
    <div class="card text-white border-secondary shadow-lg p-4" style="background-color: rgba(30, 30, 30, 0.95) !important; border-radius: 12px; max-width: 600px;">
        <h2 class="text-white fw-bold mb-4">Add New Instructor</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label text-light fw-semibold">Name</label>
                <input asp-for="Name" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label text-light fw-semibold">Email</label>
                <input asp-for="Email" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Bio" class="form-label text-light fw-semibold">Bio</label>
                <textarea asp-for="Bio" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
                <span asp-validation-for="Bio" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 w-100 mt-4">
                <input type="submit" value="Save Instructor" class="btn btn-modest-add w-50 py-2" />
                <a asp-controller="Instructor" asp-action="Index" class="btn btn-secondary w-50 py-2 text-center">Back to List</a>
            </div>
        </form>
    </div>
</div>