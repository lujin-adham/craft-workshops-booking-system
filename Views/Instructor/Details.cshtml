@model CraftWorkshopSystem.Models.Instructor

@{
    ViewData["Title"] = "Instructor Details";
}

<div class="container mt-5">
    <div class="card bg-dark text-white border-secondary shadow-lg p-4" style="background-color: rgba(30, 30, 30, 0.9) !important; border-radius: 12px;">
        <h2 class="text-white fw-bold mb-4">Instructor Profile</h2>
        
        <dl class="row">
            <dt class="col-sm-3 text-white">Full Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3 text-white">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3 text-white">Bio</dt>
            <dd class="col-sm-9">@Model.Bio</dd>
        </dl>

        <div class="mt-4">
            @if (ViewData["ReturnUrl"] != null)
            {
                <a href="@ViewData["ReturnUrl"]" class="btn btn-secondary">Back to Workshop</a>
            }
            else
            {
                 <a asp-action="Index" class="btn btn-secondary">Back to List</a>
            }
        </div>
    </div>
</div>