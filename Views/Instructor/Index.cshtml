@model List<CraftWorkshopSystem.Models.Instructor>

@{
    ViewData["Title"] = "Manage Instructors";
}

<div class="container mt-4">
    <h2 class="text-white fw-bold mb-4">Instructors Management Dashboard</h2>
    <p>
       <a asp-controller="Instructor" asp-action="Create" class="btn btn-modest-add mb-3">Add New Instructor</a>
    </p>
    @if (TempData["SuccessMessage"] != null)
    {
        <div id="success-alert" class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>

        <script>
            setTimeout(function() {
                var alertElement = document.getElementById('success-alert');
                if (alertElement) {
                    alertElement.style.transition = "opacity 0.5s ease";
                    alertElement.style.opacity = "0";
                    setTimeout(function() {
                       alertElement.style.display = "none";
                    }, 500);
                }
            }, 5000);
        </script>
    }

    <div class="card text-white border-secondary shadow-lg p-3" style="background-color: rgba(30, 30, 30, 0.95) !important; border-radius: 12px;">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle mb-0" style="background-color: transparent !important;">
                <thead>
                    <tr style="background-color: transparent !important;">
                        <th class="bg-transparent text-white">Name</th>
                        <th class="bg-transparent text-white">Email</th>
                        <th class="bg-transparent text-white">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr style="background-color: transparent !important;">
                            <td class="bg-transparent text-white">@item.Name</td>
                            <td class="bg-transparent text-white">@item.Email</td>
                            <td class="bg-transparent text-white">
                               <a asp-controller="Instructor" asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-modest-details">Details</a>
                               <a asp-controller="Instructor" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-modest-edit">Edit</a>
                               <a asp-controller="Instructor" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-modest-delete" onclick="return confirm('Are you sure you want to delete this?');">Delete</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>