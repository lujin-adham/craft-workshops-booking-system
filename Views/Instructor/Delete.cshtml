@model CraftWorkshopSystem.Models.Instructor

@{
    ViewData["Title"] = "Delete Instructor";
}

<div class="container mt-4">
    <h2 class="text-white mb-4">Delete Instructor</h2>
    <h3 class="text-danger">Are you sure you want to delete this?</h3>

    <div class="card bg-dark text-white p-4 mb-3">
        <dl class="row">
            <dt class="col-sm-3 text-white">Name</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3 text-white">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
        </dl>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>