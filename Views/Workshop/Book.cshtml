@model CraftWorkshopSystem.Models.Booking

@{
    ViewData["Title"] = "Workshop Booking";
}

<div class="container mt-4 mb-5" style="max-width: 750px;">
    <div class="card text-white border-secondary shadow-lg p-4" style="background-color: rgba(30, 30, 30, 0.95) !important; border-radius: 12px;">
        <h2 class="text-white fw-bold mb-4">Book Workshop: @Model.Workshop.Title</h2>

        <form asp-action="Book" method="post">
            <input type="hidden" asp-for="WorkshopId" />

            <div class="mb-3">
                <label asp-for="CustomerName" class="form-label text-light fw-semibold">Name</label>
                <input asp-for="CustomerName" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="CustomerName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="CustomerPhone" class="form-label text-light fw-semibold">Phone Number</label>
                <input asp-for="CustomerPhone" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="CustomerPhone" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 w-100 mt-4">
                <button type="submit" class="btn btn-modest-add w-50 py-2">Confirm Booking</button>
                <a asp-action="Index" class="btn btn-secondary w-50 py-2 text-center">Back to List</a>
            </div>
        </form>
    </div>
</div>