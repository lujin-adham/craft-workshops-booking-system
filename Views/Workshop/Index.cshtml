@model List<CraftWorkshopSystem.Models.Workshop>

@{
    ViewData["Title"] = "Workshops Catalog";
}

<div class="container my-4">
    <div class="text-white fw-bold mb-4">
        <h2>Upcoming Workshops . . .</h2>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card text-white border-secondary shadow-lg h-100" style="background-color: rgba(30, 30, 30, 0.95) !important; border-radius: 12px; overflow: hidden;">
                    <img src="@item.ImageUrl" class="card-img-top" alt="Workshop Image" style="height: 200px; object-fit: cover;">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title text-white fw-bold">@item.Title</h5>
                        <p class="card-text text-light">@item.Description</p>
                        <p class="card-text">
                            <strong>Instructor:</strong> 
                            <a asp-controller="Instructor" asp-action="Details" asp-route-id="@item.InstructorId" 
                               asp-route-returnUrl="@Context.Request.Path"
                               class="text-white text-decoration-underline" style="text-underline-offset: 4px;">
                                @item.Instructor.Name
                            </a>
                        </p>
                        <p class="card-text"><strong>Price:</strong> $@item.Price</p>
                        @{
                            int bookedCount = item.Bookings?.Count ?? 0;
                             int availableSeats = item.Capacity - bookedCount;
                        }
                        <p class="card-text">
                            <strong>Available Seats:</strong> 
                            @if (availableSeats > 0)
                            {
                                <span class="text-success fw-bold">@availableSeats</span>
                            }
                            else
                            {
                                <span class="text-danger fw-bold">Fully Booked</span>
                            }
                        </p>
                        <p class="card-text"><strong>Date:</strong> @item.Date.ToShortDateString()</p>
                        <p class="card-text"><strong>Location:</strong> @item.Location</p>


                        <div class="mt-auto">
                            @if (item.Capacity <= 0)
                            {
                                <button class="btn btn-secondary w-100 mb-2" disabled>Fully Booked</button>
                            }
                            else
                            {
                                <a asp-action="Book" asp-route-id="@item.Id" class="btn btn-modest-book w-100 py-2 text-center">Book Now</a>
                            }
                        </div>  
                    </div>
                </div>
            </div>
        }
    </div>
</div>