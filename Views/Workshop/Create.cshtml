@model CraftWorkshopSystem.Models.Workshop

@{
    ViewData["Title"] = "Add Workshop";
}
<div asp-validation-summary="All" class="text-danger"></div>
<div class="container mt-4 mb-5">
    <div class="card text-white border-secondary shadow-lg p-4" style="background-color: rgba(30, 30, 30, 0.95) !important; border-radius: 12px; max-width: 600px;">
        <h2 class="text-white fw-bold mb-4">Add New Workshop</h2>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label text-light fw-semibold">Title</label>
                <input asp-for="Title" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label text-light fw-semibold">Description</label>
                <textarea asp-for="Description" class="form-control bg-dark text-white border-secondary" rows="3"></textarea>
            </div>

            <div class="form-group mb-3">
                <label asp-for="InstructorId" class="control-label text-white">Instructor</label>
                <select asp-for="InstructorId" class="form-control bg-dark text-white" asp-items="@(ViewData["Instructors"] as SelectList)">
                   <option value="">-- Choose Instructor --</option>
                </select>
                <span asp-validation-for="InstructorId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label text-light fw-semibold">Price</label>
                <input asp-for="Price" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">Location</label>
                <input asp-for="Location" class="form-control bg-dark text-white" />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Date" class="form-label text-light fw-semibold">Date</label>
                <input asp-for="Date" type="date" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Date" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageUrl" class="form-label text-light fw-semibold">Image URL</label>
                <input asp-for="ImageUrl" class="form-control bg-dark text-white border-secondary" />
            </div>

            <div class="mb-4">
                <label asp-for="Capacity" class="form-label text-light fw-semibold">Capacity (Max Seats)</label>
                <input asp-for="Capacity" class="form-control bg-dark text-white border-secondary" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="d-flex gap-2 w-100 mt-4">
                <input type="submit" value="Save Workshop" class="btn btn-modest-add w-50 py-2" />
                <a asp-controller="Workshop" asp-action="Privacy" class="btn btn-secondary w-50 py-2 text-center">Back to List</a>
            </div>
        </form>
    </div>
</div>