@model CraftWorkshopSystem.Models.Workshop

@{
    ViewData["Title"] = "Workshop Details";
    int remaining = (int)ViewData["RemainingSeats"];
}

<div class="container mt-5">
    <div class="card bg-dark text-white border-secondary shadow-lg p-4" style="background-color: rgba(30, 30, 30, 0.9) !important; border-radius: 12px;">
        <h2 class="text-white fw-bold mb-4">Workshop Details</h2>
        
        <dl class="row">
            <dt class="col-sm-3 text-white">Title</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3 text-white">Price</dt>
            <dd class="col-sm-9">$@Model.Price</dd>

            <dt class="col-sm-3 text-white">Date</dt>
            <dd class="col-sm-9">@Model.Date.ToShortDateString()</dd>

            <dt class="col-sm-3 text-white">Location</dt>
            <dd class="col-sm-9">@Model.Location</dd>

            <dt class="col-sm-3 text-white">Total Capacity</dt>
            <dd class="col-sm-9">@Model.Capacity</dd>

            <dt class="col-sm-3 text-white">Available Seats</dt>
            <dd class="col-sm-9">
                @if (remaining > 0)
                {
                    <span class="text-success fw-bold">@remaining</span>
                }
                else
                {
                    <span class="text-danger fw-bold">Fully Booked</span>
                }
            </dd>
            <dt class="col-sm-3 text-white">Instructor</dt>
            <dd class="col-sm-9">
                <a asp-controller="Instructor" asp-action="Details" asp-route-id="@Model.InstructorId"class="text-white text-decoration-underline" style="text-underline-offset: 4px;" asp-route-returnUrl="@Context.Request.Path">
                    @Model.Instructor.Name
                </a>
            </dd>
        </dl>

        <div class="mt-4 mb-4">
            <a asp-controller="Workshop" asp-action="Privacy" class="btn btn-sm btn-secondary">Back to Dashboard</a>
        </div>

        <hr class="border-secondary my-4" />

        <h4 class="text-white fw-bold mb-3">Participant Records</h4>
        @if (Model.Bookings != null && Model.Bookings.Any())
        {
            <table class="table table-dark table-striped table-bordered border-secondary">
                <thead>
                    <tr>
                        <th>Participant Name</th>
                        <th>Phone Number</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model.Bookings)
                    {
                        <tr>
                            <td>@booking.CustomerName</td>
                            <td>@booking.CustomerPhone</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No bookings for this workshop yet.</p>
        }
    </div>
</div>